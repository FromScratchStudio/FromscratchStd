<style>
#triangleLeft {
    position:absolute;
    top:50%;
    left:50%;
    margin-top: -200px;
	width: 0;
	height: 0;
	border-top: 100px solid red;
	border-right: 300px solid transparent;
	border-bottom: 100px solid transparent;
    border-left: 0px solid red;
}
    
#hiddenLoadContainer
{
    position: fixed;
    top:-30000px;
    left: -30000px;
}
    
.assetLoader
{   
    clear:both;
	position:absolute;
	left:0px;
    top:0px;
    /*margin-left:-50%;
	margin-top: -25%;*//*-250px;*/
	width:100%;
	height: 100%;/*500px;*/
    z-index: 2000;
    background-color: black;
    opacity: 0.7;
}

.assetLoader img
{   
    clear:both;
	position:relative;
	left:50%;
    margin-left: -60px;
    top:50%;
    margin-top: -60px;
    /*margin-left:-50%;
	margin-top: -25%;*//*-250px;*/
	width:120px;
	height: 120px;
    z-index: 2000;
    background-color: white;
    opacity: 0.6;
    border-radius: 50%;
}
    
    #leftMenuBar
    {
        position:fixed;
        top:15px;
        left:15px;
        border: 1px solid #dedede;
	    border-radius: 4px;
	    box-shadow: 0 2px 2px -1px rgba(0, 0, 0, 0.055);
	    color: #888;
	    display: block;
        margin: 8px 22px 8px 22px;
        overflow:visible;
        width: 250px; 
        }
    
    div.NAV_BAR
    {

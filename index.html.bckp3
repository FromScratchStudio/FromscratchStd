        left:0px;
        width:40px;
        text-decoration: none;
        margin-bottom: 5px;
    }
    
    .MENU_ITEM:hover > div
    {
        display: block; 
    }
    
    .DIV_NAV_LEFT
    {
        position: absolute;
        left:0px;
        width:40px;
        height: 40px;
        background-color: black;
        border:solid 2px #585858;

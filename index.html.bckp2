<audio id="audioTrack" src="sounds/OppressingRelease.mp3" loop>Ce control ne support pas le musique.</audio>
</body>
    
<script>
var CST_FR = "FR";
var CST_EN = "EN";
var GBL_LANG = CST_FR;
var isMute = true;
var playlist = new Array();
var picAnimated =  new Array();

    
var displayController = new DisplayController();
//displayController.InitIntro();
displayController.LoadIntro();


var currentPosition = 0;
var currentPicPosition = 0;
    
var moncercleObj = document.getElementById("cerclePic");
var moncercleObjNo = document.getElementById("cerclePicNO");
var moncercleObjSo = document.getElementById("cerclePicSO");
    
    
var launchPicLoop = function ()
{
    for(var idxP = 0;idxP < displayController.Assets["Assets"].length;idxP++)
    {
        picAnimated.push({coverPath:displayController.Assets["Assets"][idxP]["Path"]});
    }
    
    if(moncercleObj != null && moncercleObj != undefined)
    {
        window.setInterval("setPic()", 100);
    }
    
}
    
var setPic = function()
{
    moncercleObj.src = picAnimated[currentPicPosition%(picAnimated.length)].coverPath;
    moncercleObjNo.src = picAnimated[currentPicPosition%(picAnimated.length)].coverPath;
    moncercleObjSo.src = picAnimated[currentPicPosition%(picAnimated.length)].coverPath;
    currentPicPosition++;
}
    
setTimeout(launchPicLoop, 1500);
    
/*var audioElemObj = document.getElementById("audioTrack");

if(audioElemObj != null && audioElemObj != undefined)
{
	//alert("picCollection[currentPosition].src ==  " + playlist[currentPosition%(playlist.length)].musicPath);
	audioElemObj.src = playlist[currentPosition%(playlist.length)].musicPath;
	audioElemObj.load();
}*/

var muteIntro = function()
{
    if(!isMute)
    {
        isMute = true;
        
        var audioElemObj = document.getElementById("audioTrack");

        if(audioElemObj != null && audioElemObj != undefined)
        {
            audioElemObj.muted = true;
            audioElemObj.pause();
        }
        
        var muteImgElemObj = document.getElementById("muteImg");
        if(muteImgElemObj != null && muteImgElemObj != undefined)
            muteImgElemObj.src = "img/logos/unmute.jpg";
    }
    else
    {
        isMute = false;
        
        var audioElemObj = document.getElementById("audioTrack");

        if(audioElemObj != null && audioElemObj != undefined)
        {
            audioElemObj.muted = false;
            audioElemObj.play();
        }
        var muteImgElemObj = document.getElementById("muteImg");
        if(muteImgElemObj != null && muteImgElemObj != undefined)
            muteImgElemObj.src = "img/logos/mute.jpg";
    }
}


var SwitchView = function(viewTagName)
{

    switch(viewTagName + "_" + GBL_LANG)
    {
        case "introContainer" + "_" + GBL_LANG:
                $('.PART_VIEW').each(function(index, element){$(element).hide();})
                $('#introContainer').show();
            break;
            
        case "whoWeAreContainer" + "_" + GBL_LANG:
                $('.PART_VIEW').each(function(index, element){$(element).hide();})
                $('#whoWeAreContainer'+ "_" + GBL_LANG).show();
            break;
            
        case "fssContainer" + "_" + GBL_LANG:
                $('.PART_VIEW').each(function(index, element){$(element).hide();})
                $('#fssContainer' + "_" + GBL_LANG).show();
            break;
            
        case "fsdContainer" + "_" + GBL_LANG:
                $('.PART_VIEW').each(function(index, element){$(element).hide();})
                $('#fsdContainer' + "_" + GBL_LANG).show();
            break;
            
        case "fsrContainer" + "_" + GBL_LANG:
                $('.PART_VIEW').each(function(index, element){$(element).hide();})
                $('#fsrContainer' + "_" + GBL_LANG).show();
            break;
            
        case "fspContainer" + "_" + GBL_LANG:
                $('.PART_VIEW').each(function(index, element){$(element).hide();})
                $('#fspContainer' + "_" + GBL_LANG).show();
            break;
            
        default:
                $('.PART_VIEW').each(function(index, element){$(element).hide();})
                $('#introContainer').show();
            break;
    }
    SwitchLanguage(GBL_LANG);
}


var SwitchSection = function(sectionName)
{
switch(sectionName + "_" + GBL_LANG)
    {
        case "philosophyWho" + "_" + GBL_LANG:
                $('.SECTION_VIEW').each(function(index, element){$(element).hide();})
                $('#philosophyWho' + "_" + GBL_LANG).show();
            break;
            
        case "presentationWho" + "_" + GBL_LANG:
                $('.SECTION_VIEW').each(function(index, element){$(element).hide();})
                $('#presentationWho' + "_" + GBL_LANG).show();
            break;
            
        default:
                $('.SECTION_VIEW').each(function(index, element){$(element).hide();})
                $('#philosophyWho'+ "_" + GBL_LANG).show();
            break;
    }
	SwitchLanguage(GBL_LANG);
}


var SwitchLanguage = function(newLangDisplay)
{
	var oldLanguage = ((newLangDisplay==CST_FR)?CST_EN:CST_FR);
	
	$('.' + oldLanguage).each(function(index, element)
						 {
							var elemId = $(element).attr('id');
		
							if($(element).is(':visible'))
							{
								$(element).hide();
								
								if(elemId.indexOf("_" + oldLanguage) > -1 )
								{
									var elementIdToDisplay = '#' + elemId.replace("_" + oldLanguage, "_" + newLangDisplay)
								
									//if(!$(elementIdToDisplay).is(':visible'))
										$(elementIdToDisplay).show();
								}
								else{
									
								}	
							}
							/*else
							{
								if(elemId.indexOf("_" + oldLanguage) > -1 )
								{
									var elementIdToDisplay = '#' + elemId.replace("_" + oldLanguage, "_" + newLangDisplay)
								
									//if(!$(elementIdToDisplay).is(':visible'))
										$(elementIdToDisplay).show();
								}
								else{
									
								}	
							}*/
						 })
                //$('#introContainer').show();
}


var ChangeSiteLanguage = function(newLangDisplay)
{
	//var oldLanguage = ((newLangDisplay==CST_FR)?CST_EN:CST_FR);
	
	switch(newLangDisplay)
	{
		case CST_FR:
			
			GBL_LANG = CST_FR;
			SwitchLanguage(GBL_LANG);
			$("#frLangImg").hide();
			$("#enLangImg").show();
			break;
			
			
		case CST_EN:
			GBL_LANG = CST_EN;
			SwitchLanguage(GBL_LANG);
			$("#enLangImg").hide();
			$("#frLangImg").show();
			break;
	}
}

SwitchLanguage(GBL_LANG);
</script>
</html>
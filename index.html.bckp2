<style>
#triangleLeft {
    position:absolute;
    top:50%;
    left:50%;
    margin-top: -200px;
	width: 0;
	height: 0;
	border-top: 100px solid red;
	border-right: 300px solid transparent;
	border-bottom: 100px solid transparent;
    border-left: 0px solid red;
}
    
#hiddenLoadContainer
{
    position: fixed;
    top:-30000px;
    left: -30000px;
}
    
.assetLoader
{   
    clear:both;
	position:absolute;
	left:0px;
    top:0px;
    /*margin-left:-50%;
	margin-top: -25%;*//*-250px;*/
	width:100%;
	height: 100%;/*500px;*/
    z-index: 2000;
    background-color: black;
    opacity: 0.7;
}

.assetLoader img
{   
    clear:both;
	position:relative;
	left:50%;
    margin-left: -60px;
    top:50%;
    margin-top: -60px;
    /*margin-left:-50%;
	margin-top: -25%;*//*-250px;*/
	width:120px;
	height: 120px;
    z-index: 2000;
    background-color: white;
    opacity: 0.6;
    border-radius: 50%;
}
    
    #leftMenuBar
    {
        position:fixed;
        top:15px;
        left:15px;
        border: 1px solid #dedede;
	    border-radius: 4px;
	    box-shadow: 0 2px 2px -1px rgba(0, 0, 0, 0.055);
	    color: #888;
	    display: block;
        margin: 8px 22px 8px 22px;
        overflow:visible;
        width: 250px; 
        }
    
    div.NAV_BAR
    {
        clear: both;
        width: 250px; 
        height:230px;
        position:absolute;
        top:45%;
        left:0px;
        margin-top: -115px;
        /*border: 1px solid pink;*/
	    border-radius: 4px;
	    box-shadow: 0 2px 2px -1px rgba(0, 0, 0, 0.055);
	    color: #888;
	    display: block;
        margin: 8px 22px 8px 22px;
        overflow:visible;
        list-style-type: none;
        z-index: 1000;
        /*display: none;*/
    }
    
    div.NAV_BAR > ul > li
    {
        list-style-type: none;
    }
    
    .MENU_ITEM
    {
        clear: both;
        position: absolute;
        left:0px;
        width:40px;
        text-decoration: none;
        margin-bottom: 5px;
    }
    
    .MENU_ITEM:hover > div
    {
        display: block; 
    }
    
    .DIV_NAV_LEFT
    {
        position: absolute;
        left:0px;
        width:40px;
        height: 40px;
        background-color: black;
        border:solid 2px #585858;
        border-radius: 50%;
        color:white;
    }
    
    .DIV_NAV_LEFT:hover
    {
        position: absolute;
        left:0px;
        width:40px;
        height: 40px;
        margin-bottom: 5px;
        border:solid 2px white;
    }
    
    .DIV_NAV_LEFT:hover .DIV_NAV_RIGHT
    {
        display: block;
        font-weight: 750;
        text-decoration:underline;
        /*text-decoration-color: white;*/
        -webkit-transition: opacity 0.2s;
        -moz-transition: opacity 0.2s;
        -ms-transition: opacity 0.2s;
        -o-transition: opacity 0.2s;
        -transition: opacity 0.2s;
    }
    
    .DIV_NAV_RIGHT
    {
        position: absolute;
        left:40px;
        width:188px;
        display: none;
    }
    
    .DIV_NAV_RIGHT_ITEM
    {
        position: absolute;
        left: 5px;
        width:188px;
        height: 40px;
        /*background-color: black;*/
        color:white;
        text-decoration: none;
    }
    
    .DIV_NAV_RIGHT_ITEM:hover
    {
        /*background-color:black;*/
        text-decoration: underline;
        font-weight: 750;
        -webkit-transition: opacity 0.2s;
        -moz-transition: opacity 0.2s;
        -ms-transition: opacity 0.2s;
        -o-transition: opacity 0.2s;
        -transition: opacity 0.2s;
    }
    
    /****************/
    
   .BTN_IMG_CIRCLE
